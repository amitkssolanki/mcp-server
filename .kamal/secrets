# Secrets for config/deploy.yml. Parsed as dotenv with Kamal's $(...) extension,
# not executed as a shell script — only KEY=value lines and inline command
# substitution work. DO NOT ENTER RAW CREDENTIALS HERE: this file is committed.
# Real values live in .env.kamal at the project root (gitignored by the /.env*
# pattern), the same arrangement as spree-restaurant, fieldnote and vrinda.

# GitHub Container Registry PAT (write:packages, read:packages).
KAMAL_REGISTRY_PASSWORD=$(grep '^KAMAL_REGISTRY_PASSWORD=' .env.kamal | cut -d '=' -f2-)

# Rails' secret key base, generated for this deploy and used only here.
SECRET_KEY_BASE=$(grep '^SECRET_KEY_BASE=' .env.kamal | cut -d '=' -f2-)

# Password for the app's own Postgres accessory (see accessories/postgres).
POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env.kamal | cut -d '=' -f2-)

# Composed here rather than in deploy.yml: config/database.yml's production
# block reads a single DATABASE_URL, and POSTGRES_PASSWORD is only in scope in
# this file. The host is the accessory's container name — Kamal names accessory
# containers "<service>-<accessory>" on the shared "kamal" Docker network, so
# it is mcp-server-postgres, not just "postgres".
DATABASE_URL=postgres://mcp_server:$(grep '^POSTGRES_PASSWORD=' .env.kamal | cut -d '=' -f2-)@mcp-server-postgres:5432/mcp_server_production
